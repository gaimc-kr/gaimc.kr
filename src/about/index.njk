---
layout: layouts/page.njk
pageKey: about
pagination:
  data: langs.codes
  size: 1
  alias: lang
permalink: "{{ langs.prefix[lang] }}/about/"
---
{%- set T = i18n[lang] -%}{%- set C = loc[lang] -%}{%- set S = C.site -%}{%- set X = collections.l10n[lang] -%}
{%- set A = C.about -%}
<nav class="subnav container" aria-label="{{ T.pages.about.title }}">
  <a href="#greeting">{{ T.about.greeting }}</a><a href="#vision">{{ T.about.vision }}</a><a href="#features">{{ T.about.features }}</a><a href="#history">{{ T.about.history }}</a>
</nav>
<section class="section" id="greeting" aria-labelledby="greeting-title">
  <div class="container greeting">
    <div class="greeting-photo">
      {% if A.greeting.photo %}<img src="{{ A.greeting.photo }}" alt="{{ A.greeting.signature_title }} {{ A.greeting.signature_name }}" width="400" height="400">{% endif %}
    </div>
    <div class="greeting-text">
      <p class="eyebrow">GREETING</p>
      <h2 id="greeting-title">{{ T.about.greeting }}</h2>
      {%- for para in A.greeting.paragraphs %}
      <p>{{ para }}</p>
      {%- endfor %}
      <p class="signature">{{ A.greeting.signature_title }} <strong>{{ A.greeting.signature_name }}</strong></p>
    </div>
  </div>
</section>
<section class="section section-sky" id="vision" aria-labelledby="vision-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">VISION &amp; GOALS</p>
      <h2 id="vision-title">{{ T.about.vision }}</h2>
    </div>
    <p class="vision-statement">{{ A.vision }}</p>
    <ol class="goal-list">
      {%- for g in A.goals %}<li><span class="goal-no" aria-hidden="true">{{ loop.index | pad2 }}</span>{{ g }}</li>{% endfor %}
    </ol>
  </div>
</section>
<section class="section" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">WHY GAIMC</p>
      <h2 id="features-title">{{ T.about.features }}</h2>
    </div>
    <ul class="feature-grid">
      {%- for f in A.features %}<li class="feature-card"><h3>{{ f.title }}</h3><p>{{ f.text }}</p></li>{% endfor %}
    </ul>
  </div>
</section>
<section class="section section-tint" id="history" aria-labelledby="history-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">HISTORY</p>
      <h2 id="history-title">{{ T.about.history }}</h2>
    </div>
    <ol class="timeline">
      {%- for h in A.history | reverse %}
      <li>
        <p class="timeline-date">{{ h.period }}</p>
        <p class="timeline-text">{{ h.text }}{% if A.history_show_counts and h.count %} <span class="timeline-count">{{ h.count }}</span>{% endif %}</p>
      </li>
      {%- endfor %}
    </ol>
    {% if A.history_note %}<p class="note">{{ A.history_note }}</p>{% endif %}
  </div>
</section>
