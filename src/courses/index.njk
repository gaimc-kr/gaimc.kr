---
layout: layouts/page.njk
pageKey: courses
pagination:
  data: langs.codes
  size: 1
  alias: lang
permalink: "{{ langs.prefix[lang] }}/courses/"
---
{%- set T = i18n[lang] -%}{%- set C = loc[lang] -%}{%- set S = C.site -%}{%- set X = collections.l10n[lang] -%}
{%- set K = C.courses -%}{%- set TC = T.courses -%}
<section class="section" aria-labelledby="tracks-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{{ TC.tracksEyebrow }}</p>
      <h2 id="tracks-title">{{ TC.tracks }}</h2>
      <p class="section-text">{{ K.intro }}</p>
    </div>
    <div class="track-grid">
      {%- for t in K.tracks %}
      <article class="track-card">
        <p class="track-type">{{ t.course_type }}</p>
        <h3>{{ t.name }}</h3>
        <dl>
          <div><dt>{{ TC.language }}</dt><dd>{{ t.language }}</dd></div>
          <div><dt>{{ TC.degree }}</dt><dd>{{ t.degree }}</dd></div>
          <div><dt>{{ TC.duration }}</dt><dd>{{ t.duration }}</dd></div>
          <div><dt>{{ TC.graduation }}</dt><dd>{{ t.graduation }}</dd></div>
          {% if t.korean %}<div><dt>{{ TC.korean }}</dt><dd>{{ t.korean }}</dd></div>{% endif %}
        </dl>
      </article>
      {%- endfor %}
    </div>
    <ul class="note-list">{% for n in K.notes %}<li>{{ n }}</li>{% endfor %}</ul>
  </div>
</section>
<section class="section section-tint" aria-labelledby="list-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{{ TC.coursesEyebrow }}</p>
      <h2 id="list-title">{{ TC.list(K.list.length) }}</h2>
      <p class="section-text">{{ TC.listText }}</p>
    </div>
    {%- for area in K.areas %}
    <div class="course-area">
      <h3 class="group-title">{{ area }}</h3>
      <div class="course-list">
        {%- for c in K.list %}{% if c.area == area %}
        <details class="course">
          <summary>
            <span class="course-name">{{ c.name }}</span>
            {% if lang != "en" %}<span class="course-en" lang="en">{{ c.name_en }}</span>{% endif %}
            {% if c.name_ai %}<span class="course-ai">{{ TC.englishTrack }} {{ c.name_ai }}</span>{% endif %}
          </summary>
          <div class="course-body">
            <p>{{ c.summary }}</p>
            <p class="course-topics"><strong>{{ TC.topics }}</strong> {{ c.topics }}</p>
          </div>
        </details>
        {%- endif %}{% endfor %}
      </div>
    </div>
    {%- endfor %}
  </div>
</section>
<section class="section" aria-labelledby="career-title">
  <div class="container">
    <div class="feature-band">
      <div>
        <p class="eyebrow">{{ TC.careerEyebrow }}</p>
        <h2 id="career-title">{{ TC.career }}</h2>
        <p>{{ K.career }}</p>
      </div>
      <a class="btn btn-primary" href="{{ '/ipp/' | L(lang) }}">{{ TC.ipp }} <span aria-hidden="true">+</span></a>
    </div>
  </div>
</section>
