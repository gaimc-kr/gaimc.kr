---
layout: layouts/page.njk
pageKey: admission
pagination:
  data: langs.codes
  size: 1
  alias: lang
permalink: "{{ langs.prefix[lang] }}/admission/"
---
{%- set T = i18n[lang] -%}{%- set C = loc[lang] -%}{%- set S = C.site -%}{%- set X = collections.l10n[lang] -%}
{%- set AD = C.admission -%}{%- set TA = T.admission -%}
<section class="section">
  <div class="container">
    <div class="callout">
      <p>{{ AD.notice }}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="{{ S.links.graduate_admission }}" target="_blank" rel="noopener">{{ T.btn.gradAdmission }}<span class="sr-only">{{ T.newWin }}</span></a>
        <a class="btn btn-outline" href="{{ '/contact/' | L(lang) }}">{{ T.btn.inquiry }}</a>
      </div>
    </div>
    <h2 class="group-title">{{ TA.overview }}</h2>
    <dl class="info-table">{% for o in AD.overview %}<div><dt>{{ o.label }}</dt><dd>{{ o.value }}</dd></div>{% endfor %}</dl>
    {%- if AD.details_published %}
    <h2 class="group-title">{{ AD.schedule_title }}</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th scope="col">{{ TA.item }}</th><th scope="col">{{ TA.schedule }}</th><th scope="col">{{ TA.note }}</th></tr></thead>
        <tbody>{% for s in AD.schedule %}<tr><th scope="row">{{ s.item }}</th><td>{{ s.date }}</td><td>{{ s.note }}</td></tr>{% endfor %}</tbody>
      </table>
    </div>
    <h2 class="group-title">{{ TA.eligibility }}</h2>
    <dl class="info-table">{% for o in AD.eligibility %}<div><dt>{{ o.label }}</dt><dd>{{ o.value }}</dd></div>{% endfor %}</dl>
    {% if AD.eligibility_highlight %}<p class="highlight">{{ AD.eligibility_highlight }}</p>{% endif %}
    <h2 class="group-title">{{ TA.selection }}</h2>
    <ul class="check-list">{% for s in AD.selection %}<li>{{ s }}</li>{% endfor %}</ul>
    {%- if AD.fees_published %}
    <h2 class="group-title">{{ AD.fees_title }}</h2>
    <dl class="info-table">{% for f in AD.fees %}<div><dt>{{ f.item }}</dt><dd>{{ f.value }}</dd></div>{% endfor %}</dl>
    {%- endif %}
    <h2 class="group-title">{{ TA.documents }}</h2>
    <dl class="info-table">{% for d in AD.documents %}<div><dt>{{ d.title }}</dt><dd>{{ d.text }}</dd></div>{% endfor %}</dl>
    <p class="note">{{ TA.basis }}: {{ AD.basis }}</p>
    {%- else %}
    <p class="placeholder-box">{{ AD.pending_text }}</p>
    {%- endif %}
  </div>
</section>
