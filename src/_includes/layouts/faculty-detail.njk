---
layout: layouts/base.njk
---
{%- set sections = [
  ["전문 분야", keywords], ["학력", education], ["주요 경력", career], ["전문 자격", certifications],
  ["논문", papers], ["도서", books], ["특허", patents], ["상표", trademarks], ["R&D 과제", rnd], ["비R&D 과제", non_rnd],
  ["주요 실적", achievements], ["강의·교육", lectures], ["실무 네트워크", network], ["상훈·위원 활동", awards]
] -%}
<div class="page-head">
  <div class="container">
    <nav class="breadcrumb" aria-label="현재 위치">
      <a href="/">홈</a><span aria-hidden="true">›</span><a href="/faculty/{{ '#speakers' if category == '특강 연사' }}">{{ "특강 연사" if category == "특강 연사" else "교수진" }}</a><span aria-hidden="true">›</span><span aria-current="page">{{ name }}</span>
    </nav>
  </div>
</div>
<article class="section profile">
  <div class="container">
    <header class="profile-head">
      <div class="profile-photo">
        {% if photo %}<img src="{{ photo }}" alt="{{ name }} {{ position }} 사진" width="400" height="400">{% else %}<span class="person-initial" aria-hidden="true">{{ name | initial }}</span>{% endif %}
      </div>
      <div class="profile-id">
        <p class="eyebrow">{{ position }}</p>
        <h1>{{ name }}{% if name_en %} <span lang="en">{{ name_en }}</span>{% endif %}</h1>
        <dl class="profile-facts">
          {% if academic %}<div><dt>현직(학계)</dt><dd>{{ academic }}</dd></div>{% endif %}
          {% if industry %}<div><dt>{{ "본직" if category == "특강 연사" else "현직(산업계)" }}</dt><dd>{{ industry }}</dd></div>{% endif %}
          {% if office or phone %}<div><dt>연구실</dt><dd>{{ office }}{% if office and phone %} · {% endif %}{% if phone %}<a href="tel:{{ phone | replace('-', '') }}">{{ phone }}</a>{% endif %}</dd></div>{% endif %}
          {% if email %}<div><dt>이메일</dt><dd><a href="mailto:{{ email }}">{{ email }}</a></dd></div>{% endif %}
        </dl>
        {%- if counts and (counts.papers or counts.books or counts.patents or counts.projects) %}
        <ul class="profile-counts">
          {% if counts.papers %}<li><strong>{{ counts.papers }}</strong>논문(편)</li>{% endif %}
          {% if counts.books %}<li><strong>{{ counts.books }}</strong>도서(권)</li>{% endif %}
          {% if counts.patents %}<li><strong>{{ counts.patents }}</strong>특허(건)</li>{% endif %}
          {% if counts.projects %}<li><strong>{{ counts.projects }}</strong>과제(건)</li>{% endif %}
        </ul>
        {%- endif %}
      </div>
    </header>
    <div class="profile-sections">
      {%- for s in sections %}{% if s[1] and s[1].length %}
      <section class="profile-section{% if s[1].length > 5 %} is-wide{% endif %}">
        <h2>{{ s[0] }} <span class="count">{{ s[1].length }}</span></h2>
        <ul class="profile-list" {% if s[1].length > 8 %}data-collapsible{% endif %}>
          {%- for item in s[1] %}{% set t = item | tagSplit %}<li>{% if t.tag %}<span class="item-tag">{{ t.tag }}</span>{% endif %}{{ t.text | linkify | safe }}</li>{% endfor %}
        </ul>
      </section>
      {%- endif %}{% endfor %}
    </div>
    <p class="back"><a class="btn btn-outline" href="/faculty/">교수진 목록</a></p>
  </div>
</article>
