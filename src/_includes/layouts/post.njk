---
layout: layouts/base.njk
---
<div class="page-head">
  <div class="container">
    <nav class="breadcrumb" aria-label="현재 위치">
      <a href="/">홈</a><span aria-hidden="true">›</span><a href="/news/">뉴스룸</a><span aria-hidden="true">›</span><span aria-current="page">{{ title }}</span>
    </nav>
    <p class="eyebrow">{{ category }}</p>
    <h1>{{ title }}</h1>
    <p class="lead"><time datetime="{{ page.date | isoDate }}">{{ page.date | krDate }}</time></p>
  </div>
</div>
<article class="section">
  <div class="container narrow">
    {% if cover %}<figure class="cover"><img src="{{ cover }}" alt="{{ cover_alt }}"></figure>{% endif %}
    <div class="prose">{{ content | safe }}</div>
    {%- if links and links.length %}
    <h2 class="group-title">관련 링크</h2>
    <ul class="link-list">
      {%- for l in links %}<li><a href="{{ l.url }}"{% if l.url.startsWith('http') %} target="_blank" rel="noopener"{% endif %}>{{ l.label }}</a></li>{% endfor %}
    </ul>
    {%- endif %}
    <p class="back"><a class="btn btn-outline" href="/news/">뉴스룸 목록</a></p>
  </div>
</article>
