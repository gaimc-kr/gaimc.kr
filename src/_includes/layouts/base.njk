{%- set lang = lang or "ko" -%}
{%- set T = i18n[lang] -%}
{%- set C = loc[lang] -%}
{%- set S = C.site -%}
{%- set heading = title or (T.pages[pageKey].title if pageKey) -%}
{%- set pageTitle = (heading + " | " + S.name) if heading else (S.name + " | " + S.school) -%}
{%- set pageDesc = description or summary or S.description -%}
<!doctype html>
<html lang="{{ T.htmlLang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ S.url }}{{ page.url }}">
  {%- if not noAlternates %}
  {%- for l in langs.codes %}
  <link rel="alternate" hreflang="{{ l }}" href="{{ S.url }}{{ page.url | switchLang(l) }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ S.url }}{{ page.url | switchLang('ko') }}">
  {%- endif %}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ {'ko':'ko_KR','en':'en_US','vi':'vi_VN'}[lang] }}">
  <meta property="og:site_name" content="{{ S.name }} | {{ S.school }}">
  <meta property="og:title" content="{{ heading or S.name }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ S.url }}{{ page.url }}">
  <meta property="og:image" content="{{ S.url }}/assets/og-image.png">
  <meta name="theme-color" content="#0047BB">
  {%- set A = loc.ko.site.analytics or {} %}
  {%- if A.google_verification %}
  <meta name="google-site-verification" content="{{ A.google_verification }}">{% endif %}
  {%- if A.naver_verification %}
  <meta name="naver-site-verification" content="{{ A.naver_verification }}">{% endif %}
  {%- if A.ga4_id %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ A.ga4_id }}"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','{{ A.ga4_id }}');</script>{% endif %}
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
  <link rel="stylesheet" href="/assets/site.css?v={{ buildVer }}">
</head>
<body class="{{ bodyClass or '' }}" data-more="{{ T.faculty.more }}" data-less="{{ T.faculty.less }}">
  <a class="skip-link" href="#main">{{ T.skip }}</a>
  {% if S.banner.show %}
  <div class="topbar"><a href="{{ S.banner.link | L(lang) }}">{{ S.banner.text }} <span aria-hidden="true">→</span></a></div>
  {% endif %}
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/quick.njk" %}
  <script src="/assets/site.js?v={{ buildVer }}" defer></script>
</body>
</html>
