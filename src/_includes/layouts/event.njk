---
layout: layouts/base.njk
---
<div class="page-head">
  <div class="container">
    <nav class="breadcrumb" aria-label="현재 위치">
      <a href="/">홈</a><span aria-hidden="true">›</span><a href="/events/">활동·행사</a><span aria-hidden="true">›</span><span aria-current="page">{{ title }}</span>
    </nav>
    <p class="eyebrow">{% if status == "upcoming" %}UPCOMING{% else %}EVENT{% endif %}</p>
    <h1>{{ title }}</h1>
    {% if title_en %}<p class="lead" lang="en">{{ title_en }}</p>{% endif %}
  </div>
</div>
<article class="section">
  <div class="container narrow">
    <dl class="info-table">
      <div><dt>일시</dt><dd><time datetime="{{ page.date | isoDate }}">{{ page.date | krRange(end_date) }}</time></dd></div>
      <div><dt>장소</dt><dd>{{ place }}</dd></div>
      {% if partners and partners.length %}<div><dt>함께한 기관</dt><dd>{{ partners | join(", ") }}</dd></div>{% endif %}
    </dl>
    {% if summary %}<p class="intro-text">{{ summary }}</p>{% endif %}
    {% if cover %}<figure class="cover"><img src="{{ cover }}" alt="{{ cover_alt }}"></figure>{% endif %}
    <div class="prose">{{ content | safe }}</div>

    {%- if program and program.length %}
    <h2 class="group-title">프로그램</h2>
    <ul class="program-list">
      {%- for p in program %}<li><span>{{ p.time }}</span>{{ p.text }}</li>{% endfor %}
    </ul>
    {%- endif %}

    {%- if topics and topics.length %}
    <h2 class="group-title">발표 주제</h2>
    <ul class="check-list">{% for t in topics %}<li>{{ t }}</li>{% endfor %}</ul>
    {%- endif %}

    {%- if speakers and speakers.length %}
    <h2 class="group-title">연사·발표자</h2>
    <ul class="speaker-rows">
      {%- for s in speakers %}
      <li>
        {%- set f = collections.faculty | findBySlug(s.faculty) %}
        {% if f and f.data.has_profile %}<a href="/faculty/{{ f.fileSlug }}/"><strong>{{ s.name }}</strong></a>{% else %}<strong>{{ s.name }}</strong>{% endif %}
        <span>{{ s.topic }}</span>
      </li>
      {%- endfor %}
    </ul>
    {%- endif %}

    {%- if gallery and gallery.length %}
    <h2 class="group-title">활동 사진</h2>
    <ul class="gallery">
      {%- for g in gallery %}<li><img src="{{ g.image }}" alt="{{ g.alt }}" loading="lazy"></li>{% endfor %}
    </ul>
    {%- endif %}
    <p class="back"><a class="btn btn-outline" href="/events/">활동·행사 목록</a></p>
  </div>
</article>
