---
layout: layouts/base.njk
---
{%- set T = i18n[lang or "ko"] -%}
{%- set P = T.pages[pageKey] -%}
<div class="page-head">
  <div class="container">
    <nav class="breadcrumb" aria-label="{{ T.here }}">
      <a href="{{ '/' | L(lang) }}">{{ T.home }}</a>
      <span aria-hidden="true">›</span><span aria-current="page">{{ P.title }}</span>
    </nav>
    {% if P.eyebrow %}<p class="eyebrow">{{ P.eyebrow }}</p>{% endif %}
    <h1>{{ P.title }}</h1>
    {% if P.lead %}<p class="lead">{{ P.lead }}</p>{% endif %}
  </div>
</div>
<div class="page-body">
  {{ content | safe }}
</div>
