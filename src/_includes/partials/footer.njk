<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="/assets/hsu-signature.svg" alt="한성대학교 HANSUNG UNIVERSITY" width="176" height="41">
      <p class="footer-dept">{{ S.graduate_school }} {{ S.name }}{% if lang != "en" %}<br><span lang="en">{{ S.name_en }}</span>{% endif %}</p>
    </div>
    <div class="footer-info">
      <p>{{ S.contact.address }} · {{ T.footer.office }} {{ S.contact.office }}</p>
      <p>{{ T.footer.gradOffice }} <a href="tel:{{ S.contact.grad_office_phone | replace('-', '') }}">{{ S.contact.grad_office_phone }}</a>
        {%- if S.contact.dept_phone %} · {{ T.footer.dept }} <a href="tel:{{ S.contact.dept_phone | replace('-', '') }}">{{ S.contact.dept_phone }}</a>{% endif %}
        {%- if S.contact.dept_email %} · <a href="mailto:{{ S.contact.dept_email }}">{{ S.contact.dept_email }}</a>{% endif %}</p>
      <p class="footer-disclaimer">{{ S.disclaimer }}</p>
    </div>
    <ul class="footer-links">
      <li><a href="{{ S.links.hansung }}" target="_blank" rel="noopener">{{ T.footer.hansung }}<span class="sr-only">{{ T.newWin }}</span></a></li>
      <li><a href="{{ S.links.graduate }}" target="_blank" rel="noopener">{{ T.footer.graduate }}<span class="sr-only">{{ T.newWin }}</span></a></li>
      <li><a href="{{ '/contact/' | L(lang) }}">{{ T.footer.contact }}</a></li>
    </ul>
  </div>
  <div class="container footer-copy">© {{ build.year }} Hansung University · {{ S.name_en }}</div>
</footer>
