{%- set curUrl = page.url or "" -%}
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="{{ '/' if lang == 'ko' else '/' + lang + '/' }}" aria-label="{{ site.school }} {{ site.name }} 홈">
      <img class="brand-mark" src="/assets/hsu-signature.svg" alt="한성대학교 HANSUNG UNIVERSITY" width="176" height="41">
      <span class="brand-dept">
        <span class="brand-ko">{{ site.name }}</span>
        <span class="brand-en">{{ site.name_en }}</span>
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="sr-only">전체 메뉴</span>
    </button>
    <div class="nav-wrap" id="site-nav" data-nav>
      <nav aria-label="주 메뉴">
        <ul class="nav-list">
          {%- for item in nav %}
          {%- if item.key != "ipp" or site.show_ipp_in_menu %}
          <li><a href="{{ item.url }}"{% if curUrl.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {%- endif %}
          {%- endfor %}
        </ul>
      </nav>
      <ul class="util-list" aria-label="보조 메뉴">
        <li><a href="/contact/"{% if curUrl.startsWith('/contact/') %} aria-current="page"{% endif %}>문의</a></li>
        <li class="lang-switch">
          <a href="/" lang="ko"{% if lang == 'ko' %} aria-current="true"{% endif %}>KOR</a>
          <a href="/en/" lang="en"{% if lang == 'en' %} aria-current="true"{% endif %}>ENG</a>
          <a href="/vi/" lang="vi"{% if lang == 'vi' %} aria-current="true"{% endif %}>VIE</a>
        </li>
      </ul>
    </div>
  </div>
</header>
