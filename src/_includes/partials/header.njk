{%- set curUrl = page.url or "" -%}
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="{{ '/' | L(lang) }}" aria-label="{{ S.school }} {{ S.name }} {{ T.homeAria }}">
      <img class="brand-mark" src="/assets/hsu-signature.svg" alt="한성대학교 HANSUNG UNIVERSITY" width="176" height="41">
      <span class="brand-dept">
        <span class="brand-ko">{{ S.name }}</span>
        <span class="brand-en">{{ S.name_en if lang != "en" else S.school }}</span>
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="sr-only">{{ T.menu }}</span>
    </button>
    <div class="nav-wrap" id="site-nav" data-nav>
      <nav aria-label="{{ T.mainNav }}">
        <ul class="nav-list">
          {%- for key in ["about", "faculty", "courses", "ipp", "partners", "events", "news", "admission"] %}
          {%- if key != "ipp" or S.show_ipp_in_menu %}
          {%- set href = ("/" + key + "/") | L(lang) %}
          <li><a href="{{ href }}"{% if curUrl.startsWith(href) %} aria-current="page"{% endif %}>{{ T.nav[key] }}</a></li>
          {%- endif %}
          {%- endfor %}
        </ul>
      </nav>
      <ul class="util-list" aria-label="{{ T.subNav }}">
        {%- set chref = "/contact/" | L(lang) %}
        <li><a href="{{ chref }}"{% if curUrl.startsWith(chref) %} aria-current="page"{% endif %}>{{ T.nav.contact }}</a></li>
        <li class="lang-switch">
          {%- for l in langs.codes %}
          <a href="{{ curUrl | switchLang(l) }}" lang="{{ l }}" hreflang="{{ l }}"{% if lang == l %} aria-current="true"{% endif %}>{{ {"ko": "KOR", "en": "ENG", "vi": "VIE"}[l] }}</a>
          {%- endfor %}
        </li>
      </ul>
    </div>
  </div>
</header>
