---
layout: layouts/page.njk
pageKey: partners
pagination:
  data: langs.codes
  size: 1
  alias: lang
permalink: "{{ langs.prefix[lang] }}/partners/"
---
{%- set T = i18n[lang] -%}{%- set C = loc[lang] -%}{%- set S = C.site -%}{%- set X = collections.l10n[lang] -%}
{%- set PT = C.partners -%}
<section class="section">
  <div class="container">
    <p class="intro-text">{{ PT.intro }}</p>
    {%- for c in PT.list | uniqueValues("country") %}
    <h2 class="group-title">{{ c }}</h2>
    <ul class="partner-list">
      {%- for p in PT.list %}{% if p.country == c %}
      <li class="partner-card">
        {%- if p.logo %}<img src="{{ p.logo }}" alt="" width="72" height="72" loading="lazy">{% else %}<span class="partner-badge" aria-hidden="true">{{ p.abbr }}</span>{% endif %}
        <div>
          <h3>{% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.name }}<span class="sr-only">{{ T.newWin }}</span></a>{% else %}{{ p.name }}{% endif %}</h3>
          {% if p.name_en and p.name_en != p.name %}<p class="partner-en" lang="en">{{ p.name_en }}</p>{% endif %}
          {% if p.name_local %}<p class="partner-en" lang="vi">{{ p.name_local }}</p>{% endif %}
          <p>{{ p.description }}</p>
          {%- set ev = X.events | findBySlug(p.event) %}
          {% if ev %}<a class="view-more" href="{{ ev.url }}">{{ T.partners.related }} <span aria-hidden="true">+</span></a>{% endif %}
        </div>
      </li>
      {%- endif %}{% endfor %}
    </ul>
    {%- endfor %}
    <h2 class="group-title">{{ T.partners.domestic }}</h2>
    {%- if PT.domestic and PT.domestic.length %}
    <ul class="company-logos">
      {%- for d in PT.domestic %}
      <li><span class="company-logo"><img src="{{ d.logo }}" alt="" loading="lazy"></span><span class="company-name">{{ d.name }}</span></li>
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="placeholder-box">{{ PT.domestic_text }}</p>
    {%- endif %}
  </div>
</section>
