---
layout: layouts/page.njk
pageKey: faculty
pagination:
  data: langs.codes
  size: 1
  alias: lang
permalink: "{{ langs.prefix[lang] }}/faculty/"
---
{%- set T = i18n[lang] -%}{%- set C = loc[lang] -%}{%- set S = C.site -%}{%- set X = collections.l10n[lang] -%}
{%- set F = T.faculty -%}{%- set PP = C.people -%}
<nav class="subnav container" aria-label="{{ T.pages.faculty.title }}">
  {%- for c in facultyCategories %}<a href="#cat-{{ loop.index }}">{{ F.categories[c] }}</a>{% endfor %}<a href="#speakers">{{ PP.speakers.title }}</a><a href="#researchers">{{ PP.researchers.title }}</a>
</nav>
{%- for c in facultyCategories %}
{%- set members = X.faculty | where("category", c) %}
{%- if members.length %}
<section class="section{% if loop.index is even %} section-tint{% endif %}" id="cat-{{ loop.index }}" aria-labelledby="cat-{{ loop.index }}-title">
  <div class="container">
    <h2 class="group-title" id="cat-{{ loop.index }}-title">{{ F.categories[c] }} <span class="count">{{ F.count(members.length) }}</span></h2>
    <ul class="person-grid">
      {%- for p in members %}{% include "partials/faculty-card.njk" %}{% endfor %}
    </ul>
  </div>
</section>
{%- endif %}
{%- endfor %}
<section class="section section-sky" id="speakers" aria-labelledby="speakers-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{{ PP.speakers.title_en | upper }}</p>
      <h2 id="speakers-title">{{ PP.speakers.title }} <span class="count">{{ F.count(PP.speakers.count) }}</span></h2>
      <p class="section-text">{{ PP.speakers.text }}</p>
    </div>
    {%- set speakerPages = X.faculty | where("category", "특강연사") %}
    {%- if speakerPages.length %}
    <ul class="person-grid">
      {%- for p in speakerPages %}{% include "partials/faculty-card.njk" %}{% endfor %}
    </ul>
    {%- endif %}
    {%- if PP.speakers.list.length %}
    <ul class="speaker-grid">
      {%- for s in PP.speakers.list | sort(false, false, "name") %}
      <li class="speaker-card">
        <p class="person-name">{{ s.name }}</p>
        <p class="person-meta">{{ s.affiliation }}</p>
        {% if s.fields and s.fields.length %}<ul class="tags">{% for f in s.fields | limit(3) %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
      </li>
      {%- endfor %}
    </ul>
    {%- endif %}
    {%- if speakerPages.length + PP.speakers.list.length < PP.speakers.count %}
    <p class="placeholder-box">{{ PP.speakers.pending_text }}</p>
    {%- endif %}
  </div>
</section>
<section class="section" id="researchers" aria-labelledby="researchers-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{{ PP.researchers.title_en | upper }}</p>
      <h2 id="researchers-title">{{ PP.researchers.title }}</h2>
      <p class="section-text">{{ PP.researchers.text }}</p>
    </div>
    <ul class="researcher-list">
      {%- for r in PP.researchers.list %}<li><strong>{{ r.name }}</strong><span>{{ r.role }}</span></li>{% endfor %}
    </ul>
  </div>
</section>
