---
layout: layouts/page.njk
title: 교수진
eyebrow: FACULTY
lead: 학술 연구와 산업 현장 경험을 겸비한 교수진이 함께합니다.
---
<nav class="subnav container" aria-label="교수진 구분">
  {%- for c in facultyCategories %}<a href="#cat-{{ loop.index }}">{{ c }}</a>{% endfor %}<a href="#speakers">{{ people.speakers.title }}</a><a href="#researchers">{{ people.researchers.title }}</a>
</nav>
{%- for c in facultyCategories %}
{%- set members = collections.faculty | where("category", c) %}
{%- if members.length %}
<section class="section{% if loop.index is even %} section-tint{% endif %}" id="cat-{{ loop.index }}" aria-labelledby="cat-{{ loop.index }}-title">
  <div class="container">
    <h2 class="group-title" id="cat-{{ loop.index }}-title">{{ c }} <span class="count">{{ members.length }}명</span></h2>
    <ul class="person-grid">
      {%- for p in members %}{% include "partials/faculty-card.njk" %}{% endfor %}
    </ul>
  </div>
</section>
{%- endif %}
{%- endfor %}

<section class="section section-sky" id="speakers" aria-labelledby="speakers-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{{ people.speakers.title_en | upper }}</p>
      <h2 id="speakers-title">{{ people.speakers.title }} <span class="count">{{ people.speakers.count }}명</span></h2>
      <p class="section-text">{{ people.speakers.text }}</p>
    </div>
    {%- if people.speakers.list.length %}
    <ul class="speaker-grid">
      {%- for s in people.speakers.list | sort(false, false, "name") %}
      <li class="speaker-card">
        <p class="person-name">{{ s.name }}</p>
        <p class="person-meta">{{ s.affiliation }}</p>
        {% if s.fields and s.fields.length %}<ul class="tags">{% for f in s.fields | limit(3) %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
      </li>
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="placeholder-box">{{ people.speakers.pending_text }}</p>
    {%- endif %}
  </div>
</section>

<section class="section" id="researchers" aria-labelledby="researchers-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{{ people.researchers.title_en | upper }}</p>
      <h2 id="researchers-title">{{ people.researchers.title }}</h2>
      <p class="section-text">{{ people.researchers.text }}</p>
    </div>
    <ul class="researcher-list">
      {%- for r in people.researchers.list %}
      <li><strong>{{ r.name }}</strong><span>{{ r.role }}</span></li>
      {%- endfor %}
    </ul>
  </div>
</section>
