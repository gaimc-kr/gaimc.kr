---
layout: layouts/base.njk
pagination:
  data: collections.newsPages
  size: 1
  alias: item
permalink: "{{ item.url }}"
eleventyComputed:
  lang: "{{ item.lang }}"
  title: "{{ item.data.title }}"
  description: "{{ item.data.summary }}"
---
{%- set T = i18n[lang] -%}{%- set d = item.data -%}
<div class="page-head">
  <div class="container">
    <nav class="breadcrumb" aria-label="{{ T.here }}">
      <a href="{{ '/' | L(lang) }}">{{ T.home }}</a><span aria-hidden="true">›</span><a href="{{ '/news/' | L(lang) }}">{{ T.pages.news.title }}</a><span aria-hidden="true">›</span><span aria-current="page">{{ d.title }}</span>
    </nav>
    <p class="eyebrow">{{ d.category }}</p>
    <h1>{{ d.title }}</h1>
    <p class="lead"><time datetime="{{ item.date | isoDate }}">{{ item.date | ldate(lang) }}</time></p>
  </div>
</div>
<article class="section">
  <div class="container narrow">
    {% if d.cover %}<figure class="cover"><img src="{{ d.cover }}" alt="{{ d.cover_alt }}"></figure>{% endif %}
    <div class="prose">{{ item.body | safe }}</div>
    {%- if d.links and d.links.length %}
    <h2 class="group-title">{{ T.news.related }}</h2>
    <ul class="link-list">{% for l in d.links %}<li><a href="{{ l.url | L(lang) }}"{% if l.url.startsWith('http') %} target="_blank" rel="noopener"{% endif %}>{{ l.label }}</a></li>{% endfor %}</ul>
    {%- endif %}
    <p class="back"><a class="btn btn-outline" href="{{ '/news/' | L(lang) }}">{{ T.news.back }}</a></p>
  </div>
</article>
