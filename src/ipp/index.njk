---
layout: layouts/page.njk
pageKey: ipp
pagination:
  data: langs.codes
  size: 1
  alias: lang
permalink: "{{ langs.prefix[lang] }}/ipp/"
---
{%- set T = i18n[lang] -%}{%- set C = loc[lang] -%}{%- set S = C.site -%}{%- set X = collections.l10n[lang] -%}
{%- set I = C.ipp -%}
<section class="section">
  <div class="container narrow">
    {% if I.preparing %}<p class="placeholder-box"><strong>{{ T.ipp.preparing }}</strong> {{ I.preparing_text }}</p>{% endif %}
    <p class="intro-text">{{ I.intro }}</p>
    <ul class="feature-grid cols-3">
      {%- for b in I.blocks %}<li class="feature-card"><h2 class="h3">{{ b.title }}</h2><p>{{ b.text }}</p></li>{% endfor %}
    </ul>
    <div class="feature-band">
      <div>
        <p class="eyebrow">EXPERTS</p>
        <h2>{{ T.ipp.experts }}</h2>
        <p>{{ I.experts_text }}</p>
      </div>
      <a class="btn btn-primary" href="{{ '/faculty/#speakers' | L(lang) }}">{{ T.btn.speakers }} <span aria-hidden="true">+</span></a>
    </div>
    <p class="note">{{ T.ipp.officialPre }}<a href="{{ S.links.ipp }}" target="_blank" rel="noopener">{{ T.ipp.officialLink }}<span class="sr-only">{{ T.newWin }}</span></a>{{ T.ipp.officialPost }}</p>
  </div>
</section>
