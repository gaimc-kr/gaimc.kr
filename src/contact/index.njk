---
layout: layouts/page.njk
pageKey: contact
pagination:
  data: langs.codes
  size: 1
  alias: lang
permalink: "{{ langs.prefix[lang] }}/contact/"
---
{%- set T = i18n[lang] -%}{%- set C = loc[lang] -%}{%- set S = C.site -%}{%- set X = collections.l10n[lang] -%}
{%- set TC = T.contact -%}
<section class="section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-card">
        <h2 class="h3">{{ TC.deptOffice }}</h2>
        <p>{{ S.contact.office_detail }}</p>
        {% if S.contact.dept_phone %}<p>{{ TC.phone }} <a href="tel:{{ S.contact.dept_phone | replace('-', '') }}">{{ S.contact.dept_phone }}</a></p>{% endif %}
        {% if S.contact.dept_email %}<p>{{ TC.email }} <a href="mailto:{{ S.contact.dept_email }}">{{ S.contact.dept_email }}</a></p>{% endif %}
      </div>
      <div class="contact-card">
        <h2 class="h3">{{ TC.gradOffice }}</h2>
        <p>{{ TC.gradOfficeText }}</p>
        <p>{{ TC.phone }} <a href="tel:{{ S.contact.grad_office_phone | replace('-', '') }}">{{ S.contact.grad_office_phone }}</a> · {{ TC.fax }} {{ S.contact.grad_office_fax }}</p>
        <p><a href="{{ S.links.graduate }}" target="_blank" rel="noopener">{{ T.footer.graduate }}<span class="sr-only">{{ T.newWin }}</span></a></p>
      </div>
      {%- set park = X.faculty | findBySlug("park-yangsoo") %}
      {%- if park %}
      <div class="contact-card">
        <h2 class="h3">{{ TC.lab }} ({{ park.data.name if lang == "ko" else park.data.name_en }})</h2>
        <p>{{ park.data.office }} · {{ TC.labText }}</p>
        <p>{{ TC.phone }} <a href="tel:{{ park.data.phone | replace('-', '') }}">{{ park.data.phone }}</a></p>
        <p>{{ TC.email }} <a href="mailto:{{ park.data.email }}">{{ park.data.email }}</a></p>
      </div>
      {%- endif %}
    </div>
    <h2 class="group-title">{{ TC.directions }}</h2>
    <dl class="info-table"><div><dt>{{ TC.address }}</dt><dd>{{ S.contact.address }} {{ S.contact.office }}</dd></div></dl>
    <p class="note">{{ C.admission.notice }}</p>
  </div>
</section>
