---
permalink: /admin/config.yml
eleventyExcludeFromCollections: true
---
{%- set R = site.cms.root -%}
# 관리자 화면 설정(Sveltia CMS, Decap CMS 호환). 저장하면 GitHub 저장소에 커밋되고 사이트가 자동 배포됩니다.
backend:
  name: github
  repo: {{ site.cms.repo }}
  branch: {{ site.cms.branch }}
  commit_messages:
    create: "콘텐츠 추가: {{ '{{collection}}' }} {{ '{{slug}}' }}"
    update: "콘텐츠 수정: {{ '{{collection}}' }} {{ '{{slug}}' }}"
    delete: "콘텐츠 삭제: {{ '{{collection}}' }} {{ '{{slug}}' }}"
    uploadMedia: "사진 업로드: {{ '{{path}}' }}"
    deleteMedia: "사진 삭제: {{ '{{path}}' }}"

site_url: {{ site.url }}
display_url: {{ site.url }}
logo_url: /assets/favicon.svg
media_folder: {{ R }}src/images/uploads
public_folder: /images/uploads

collections:
  - name: news
    label: 뉴스룸
    label_singular: 뉴스
    description: 행사 결과, 협력 소식, 수상, 언론 보도 등 학과 홍보성 소식만 게시합니다. 학사·입학·장학 공지는 학교 홈페이지로 안내합니다.
    folder: {{ R }}src/news/items
    create: true
    slug: "{{ '{{year}}-{{month}}-{{day}}-{{fields.url_slug}}' }}"
    sortable_fields: [date, title]
    summary: "{{ '{{date}} · {{title}}' }}"
    fields:
      - { label: 제목, name: title, widget: string }
      - { label: 주소용 영문 이름, name: url_slug, widget: string, required: false, hint: "예 expo-visit. 영문 소문자와 하이픈만. 새 글을 만들 때 주소에 쓰입니다." }
      - { label: 게시일, name: date, widget: datetime, format: "YYYY-MM-DD", date_format: "YYYY-MM-DD", time_format: false }
      - { label: 구분, name: category, widget: select, options: [학과 소식, 언론 보도], default: 학과 소식 }
      - { label: 요약(목록에 표시), name: summary, widget: text, required: false }
      - { label: 대표 사진, name: cover, widget: image, required: false }
      - { label: 대표 사진 설명(대체 텍스트), name: cover_alt, widget: string, required: false }
      - { label: 본문(3~5문단), name: body, widget: markdown }
      - label: 관련 링크
        name: links
        widget: list
        required: false
        fields:
          - { label: 링크 이름, name: label, widget: string }
          - { label: 주소, name: url, widget: string }
      - { label: 관리 메모(화면 비노출), name: memo, widget: text, required: false }
      - { label: 비공개(초안), name: draft, widget: boolean, default: false, required: false }

  - name: events
    label: 활동·행사
    label_singular: 행사
    folder: {{ R }}src/events/items
    create: true
    slug: "{{ '{{year}}-{{month}}-{{day}}-{{fields.url_slug}}' }}"
    sortable_fields: [date, title]
    summary: "{{ '{{date}} · {{title}}' }}"
    fields:
      - { label: 행사명, name: title, widget: string }
      - { label: 영문 행사명, name: title_en, widget: string, required: false }
      - { label: 주소용 영문 이름, name: url_slug, widget: string, required: false, hint: "예 hanoi-seminar. 새 행사를 만들 때 주소에 쓰입니다." }
      - { label: 시작일, name: date, widget: datetime, format: "YYYY-MM-DD", date_format: "YYYY-MM-DD", time_format: false }
      - { label: 종료일, name: end_date, widget: datetime, format: "YYYY-MM-DD", date_format: "YYYY-MM-DD", time_format: false, required: false }
      - { label: 장소, name: place, widget: string }
      - { label: 한 줄 요약, name: summary, widget: text }
      - { label: 상태, name: status, widget: select, options: [{ label: 예정, value: upcoming }, { label: 종료, value: done }], default: done }
      - { label: 대표 사진, name: cover, widget: image, required: false }
      - { label: 대표 사진 설명, name: cover_alt, widget: string, required: false }
      - { label: 본문, name: body, widget: markdown }
      - label: 프로그램
        name: program
        widget: list
        required: false
        fields:
          - { label: 시간·일자, name: time, widget: string }
          - { label: 내용, name: text, widget: string }
      - { label: 발표 주제, name: topics, widget: list, required: false }
      - label: 연사·발표자
        name: speakers
        widget: list
        required: false
        fields:
          - { label: 이름, name: name, widget: string }
          - { label: 발표 주제, name: topic, widget: string, required: false }
          - { label: 교수 상세 페이지 연결(교수 파일 이름, 예 park-yangsoo), name: faculty, widget: string, required: false }
      - { label: 함께한 기관, name: partners, widget: list, required: false }
      - label: 활동 사진(3~6장)
        name: gallery
        widget: list
        required: false
        fields:
          - { label: 사진, name: image, widget: image }
          - { label: 사진 설명(대체 텍스트), name: alt, widget: string }
      - { label: 관리 메모(화면 비노출), name: memo, widget: text, required: false }
      - { label: 비공개(초안), name: draft, widget: boolean, default: false, required: false }

  - name: faculty
    label: 교수진
    label_singular: 교수
    description: 제출 프로필이 있는 교수만 "상세 페이지 생성"을 켭니다. 휴대폰 번호, 생년월일은 입력하지 않습니다.
    folder: {{ R }}src/faculty/people
    create: true
    identifier_field: name
    slug: "{{ '{{fields.url_slug}}' }}"
    summary: "{{ '{{category}} · {{name}}' }}"
    sortable_fields: [name, category, order]
    fields:
      - { label: 이름, name: name, widget: string }
      - { label: 영문 이름, name: name_en, widget: string, required: false }
      - { label: 주소용 영문 이름, name: url_slug, widget: string, required: false, hint: "새 교수를 추가할 때 주소(/faculty/영문이름/)에 쓰입니다. 예 hong-gildong" }
      - { label: 구분, name: category, widget: select, options: [특임명예교수, 전임교수, 초빙교수, 겸임교수] }
      - { label: 표시 직위, name: position, widget: string, hint: "예 전임교수, 학과장·특임명예교수" }
      - { label: 구분 안 표시 순서, name: order, widget: number, value_type: int, required: false }
      - { label: 사진(정사각형), name: photo, widget: image, required: false }
      - { label: 상세 페이지 생성, name: has_profile, widget: boolean, default: false }
      - { label: 공개용 이메일(본인 희망 시), name: email, widget: string, required: false }
      - { label: 연구실, name: office, widget: string, required: false }
      - { label: 연구실 유선번호, name: phone, widget: string, required: false }
      - { label: 현직(학계), name: academic, widget: string, required: false }
      - { label: 현직(산업계), name: industry, widget: string, required: false }
      - { label: 전문 분야 키워드(2~3개), name: keywords, widget: list, required: false }
      - label: 요약 수치
        name: counts
        widget: object
        required: false
        fields:
          - { label: 논문(편), name: papers, widget: number, required: false }
          - { label: 도서(권), name: books, widget: number, required: false }
          - { label: 특허(건), name: patents, widget: number, required: false }
          - { label: 과제(건), name: projects, widget: number, required: false }
      - { label: 학력, name: education, widget: list, required: false }
      - { label: 주요 경력, name: career, widget: list, required: false }
      - { label: 전문 자격, name: certifications, widget: list, required: false }
      - { label: 논문, name: papers, widget: list, required: false, hint: "앞에 [KCI], [학술대회], [학위논문] 등을 붙이면 구분 표시가 나옵니다. 전체 실적을 빠짐없이 입력" }
      - { label: 도서, name: books, widget: list, required: false }
      - { label: 특허, name: patents, widget: list, required: false, hint: "앞에 [등록] 또는 [출원]을 붙이면 구분 표시가 나옵니다" }
      - { label: 상표, name: trademarks, widget: list, required: false }
      - { label: R&D 과제, name: rnd, widget: list, required: false }
      - { label: 비R&D 과제, name: non_rnd, widget: list, required: false }
      - { label: 주요 실적, name: achievements, widget: list, required: false }
      - { label: 강의·교육, name: lectures, widget: list, required: false }
      - { label: 실무 네트워크, name: network, widget: list, required: false }
      - { label: 상훈·위원 활동, name: awards, widget: list, required: false }
      - { label: 관리 메모(화면 비노출), name: memo, widget: text, required: false }
      - { label: 비공개, name: draft, widget: boolean, default: false, required: false }

  - name: settings
    label: 페이지 내용·설정
    editor: { preview: false }
    files:
      - label: 사이트 설정(배너, 연락처, 링크)
        name: site
        file: {{ R }}src/_data/site.yml
        fields:
          - { label: 사이트 주소, name: url, widget: string }
          - { label: 학과명, name: name, widget: string }
          - { label: 영문 학과명, name: name_en, widget: string }
          - { label: 학교, name: school, widget: string }
          - { label: 소속 대학원, name: graduate_school, widget: string }
          - { label: 사이트 설명(검색 결과), name: description, widget: text }
          - label: 상단 띠 배너(입시 기간에만 켬)
            name: banner
            widget: object
            fields:
              - { label: 표시, name: show, widget: boolean }
              - { label: 문구, name: text, widget: string }
              - { label: 링크, name: link, widget: string }
              - { label: 관리 메모, name: memo, widget: text, required: false }
          - { label: 첫 화면 사진, name: hero_image, widget: image, required: false }
          - { label: 첫 화면 사진 설명, name: hero_image_alt, widget: string, required: false }
          - { label: 메뉴에 글로벌 IPP 표시, name: show_ipp_in_menu, widget: boolean }
          - label: 연락처
            name: contact
            widget: object
            fields:
              - { label: 주소, name: address, widget: string }
              - { label: 학과 사무실, name: office, widget: string }
              - { label: 학과 사무실(상세), name: office_detail, widget: string }
              - { label: 학과 전화(확인 후 입력), name: dept_phone, widget: string, required: false }
              - { label: 학과 이메일(확인 후 입력), name: dept_email, widget: string, required: false }
              - { label: 대학원교학팀 전화, name: grad_office_phone, widget: string }
              - { label: 대학원교학팀 팩스, name: grad_office_fax, widget: string }
              - { label: 관리 메모, name: memo, widget: text, required: false }
          - label: 학교 공식 링크
            name: links
            widget: object
            fields:
              - { label: 한성대학교, name: hansung, widget: string }
              - { label: 대학원 홈페이지, name: graduate, widget: string }
              - { label: 대학원 입학 안내, name: graduate_admission, widget: string }
              - { label: 대학원 학사일정, name: graduate_calendar, widget: string }
              - { label: 종합정보시스템, name: portal, widget: string }
              - { label: 한성대 IPP, name: ipp, widget: string }
              - { label: 원서접수(유웨이어플라이), name: apply, widget: string }
              - { label: 관리 메모, name: memo, widget: text, required: false }
          - { label: 하단 안내 문구, name: disclaimer, widget: text }
          - label: 관리자 화면 연결(변경 주의)
            name: cms
            widget: object
            fields:
              - { label: 저장소(조직/저장소), name: repo, widget: string }
              - { label: 브랜치, name: branch, widget: string }
              - { label: 사이트 폴더 경로, name: root, widget: string, required: false }

      - label: 메인 페이지
        name: home
        file: {{ R }}src/_data/home.yml
        fields:
          - label: 첫 화면
            name: hero
            widget: object
            fields:
              - { label: 영문 소제목, name: eyebrow, widget: string }
              - { label: 제목, name: title, widget: string }
              - { label: 부제, name: subtitle, widget: text }
          - label: 한눈에 보는 학과
            name: stats
            widget: list
            summary: "{{ '{{label}} {{value}}{{unit}}' }}"
            fields:
              - { label: 항목, name: label, widget: string }
              - { label: 수치, name: value, widget: string }
              - { label: 단위, name: unit, widget: string }
              - { label: 설명, name: detail, widget: string, required: false }
              - { label: 관리 메모, name: memo, widget: string, required: false }
          - label: 글로벌 IPP 소개
            name: ipp
            widget: object
            fields:
              - { label: 제목, name: title, widget: string }
              - { label: 문구, name: text, widget: text }
              - { label: 관리 메모, name: memo, widget: string, required: false }
          - label: 무엇을 배우나요
            name: learn
            widget: list
            summary: "{{ '{{title}}' }}"
            fields:
              - { label: 제목, name: title, widget: string }
              - { label: 문구, name: text, widget: text }
              - { label: 관리 메모, name: memo, widget: string, required: false }
          - { label: 협력 기관 문구, name: partners_text, widget: text }
          - { label: 교수진 문구, name: faculty_text, widget: text }
          - label: 이용자별 바로가기
            name: quick
            widget: list
            summary: "{{ '{{group}}' }}"
            fields:
              - { label: 이용자, name: group, widget: string }
              - label: 링크
                name: links
                widget: list
                fields:
                  - { label: 이름, name: label, widget: string }
                  - { label: 주소, name: url, widget: string }

      - label: 학과소개(인사말·비전·특징·연혁)
        name: about
        file: {{ R }}src/_data/about.yml
        fields:
          - label: 학과장 인사말
            name: greeting
            widget: object
            fields:
              - { label: 문단, name: paragraphs, widget: list, field: { label: 문단, name: p, widget: text } }
              - { label: 서명 직함, name: signature_title, widget: string }
              - { label: 서명 이름, name: signature_name, widget: string }
              - { label: 사진, name: photo, widget: image, required: false }
              - { label: 관리 메모, name: memo, widget: text, required: false }
          - { label: 비전, name: vision, widget: string }
          - { label: 교육목표, name: goals, widget: list }
          - { label: 교육목표 메모, name: goals_memo, widget: string, required: false }
          - label: 학과 특징
            name: features
            widget: list
            summary: "{{ '{{title}}' }}"
            fields:
              - { label: 특징, name: title, widget: string }
              - { label: 설명, name: text, widget: text }
              - { label: 관리 메모, name: memo, widget: string, required: false }
          - { label: 연혁에 기수별 입학 인원 표시, name: history_show_counts, widget: boolean }
          - label: 연혁
            name: history
            widget: list
            summary: "{{ '{{period}} {{text}}' }}"
            fields:
              - { label: 시기, name: period, widget: string, hint: "예 2026. 9." }
              - { label: 내용, name: text, widget: text }
              - { label: 입학 인원, name: count, widget: string, required: false }
          - { label: 연혁 하단 안내, name: history_note, widget: string, required: false }

      - label: 교육과정
        name: courses
        file: {{ R }}src/_data/courses.yml
        fields:
          - { label: 소개 문구, name: intro, widget: text }
          - { label: 관리 메모, name: memo, widget: text, required: false }
          - label: 전공·과정
            name: tracks
            widget: list
            summary: "{{ '{{name}}({{course_type}})' }}"
            fields:
              - { label: 전공명, name: name, widget: string }
              - { label: 과정, name: course_type, widget: string }
              - { label: 수업 언어, name: language, widget: string }
              - { label: 학위과정, name: degree, widget: string }
              - { label: 수업 연한, name: duration, widget: string }
              - { label: 졸업 요건, name: graduation, widget: text }
              - { label: 한국어 요건, name: korean, widget: text, required: false }
              - { label: 관리 메모, name: memo, widget: string, required: false }
          - { label: 안내 사항, name: notes, widget: list }
          - { label: 영역(표시 순서), name: areas, widget: list }
          - label: 교과목
            name: list
            widget: list
            summary: "{{ '[{{area}}] {{name}}' }}"
            fields:
              - { label: 영역, name: area, widget: string, hint: "위 영역 이름과 똑같이 입력" }
              - { label: 교과목명, name: name, widget: string }
              - { label: 영어트랙 교과목명, name: name_ai, widget: string, required: false }
              - { label: 영문 교과목명, name: name_en, widget: string }
              - { label: 소개, name: summary, widget: text }
              - { label: 주요 교육 내용, name: topics, widget: text }
          - { label: 진로 문구, name: career, widget: text }
          - { label: 진로 메모, name: career_memo, widget: string, required: false }

      - label: 글로벌 IPP
        name: ipp
        file: {{ R }}src/_data/ipp.yml
        fields:
          - { label: 준비 중 표시, name: preparing, widget: boolean }
          - { label: 준비 중 문구, name: preparing_text, widget: text }
          - { label: 소개, name: intro, widget: text }
          - label: 구성
            name: blocks
            widget: list
            summary: "{{ '{{title}}' }}"
            fields:
              - { label: 제목, name: title, widget: string }
              - { label: 내용, name: text, widget: text }
          - { label: 함께하는 전문가 문구, name: experts_text, widget: text }
          - { label: 관리 메모, name: memo, widget: text, required: false }

      - label: 글로벌 협력(협력기관)
        name: partners
        file: {{ R }}src/_data/partners.yml
        fields:
          - { label: 소개 문구, name: intro, widget: text }
          - label: 협력기관
            name: list
            widget: list
            summary: "{{ '[{{country}}] {{name}}' }}"
            fields:
              - { label: 국가, name: country, widget: string }
              - { label: 기관명, name: name, widget: string }
              - { label: 영문 기관명, name: name_en, widget: string, required: false }
              - { label: 현지어 기관명, name: name_local, widget: string, required: false }
              - { label: 약칭(로고 없을 때 표시), name: abbr, widget: string }
              - { label: 로고, name: logo, widget: image, required: false }
              - { label: 상태, name: status, widget: select, options: [{ label: 협약 체결, value: signed }, { label: 협력 중, value: active }] }
              - { label: 협력 내용 한 줄, name: description, widget: text }
              - { label: 관련 행사(행사 주소 이름, 예 korea-vietnam-seminar), name: event, widget: string, required: false }
              - { label: 홈페이지, name: url, widget: string, required: false }
          - { label: 국내 협력 안내 문구, name: domestic_text, widget: text }
          - { label: 관리 메모, name: memo, widget: text, required: false }

      - label: 입학안내
        name: admission
        file: {{ R }}src/_data/admission.yml
        fields:
          - { label: 세부 안내 공개(공식 모집요강 공고 후), name: details_published, widget: boolean }
          - { label: 전형료·등록금·장학금 공개, name: fees_published, widget: boolean }
          - { label: 기준 자료, name: basis, widget: text }
          - { label: 안내 문구, name: notice, widget: text }
          - { label: 공개 전 안내 문구, name: pending_text, widget: text }
          - label: 모집 개요
            name: overview
            widget: list
            summary: "{{ '{{label}}' }}"
            fields: [{ label: 항목, name: label, widget: string }, { label: 내용, name: value, widget: text }]
          - { label: 모집 개요 메모, name: overview_memo, widget: text, required: false }
          - { label: 일정 제목, name: schedule_title, widget: string }
          - label: 일정
            name: schedule
            widget: list
            summary: "{{ '{{item}}' }}"
            fields: [{ label: 구분, name: item, widget: string }, { label: 일정, name: date, widget: string }, { label: 비고, name: note, widget: string, required: false }]
          - label: 지원 자격
            name: eligibility
            widget: list
            summary: "{{ '{{label}}' }}"
            fields: [{ label: 구분, name: label, widget: string }, { label: 내용, name: value, widget: text }]
          - { label: 지원 자격 강조 문구, name: eligibility_highlight, widget: text, required: false }
          - { label: 지원 자격 메모, name: eligibility_memo, widget: text, required: false }
          - { label: 전형 방법, name: selection, widget: list }
          - { label: 전형료 등 제목, name: fees_title, widget: string }
          - label: 전형료·등록금·장학금
            name: fees
            widget: list
            summary: "{{ '{{item}}' }}"
            fields: [{ label: 구분, name: item, widget: string }, { label: 내용, name: value, widget: string }]
          - label: 제출 서류
            name: documents
            widget: list
            summary: "{{ '{{title}}' }}"
            fields: [{ label: 구분, name: title, widget: string }, { label: 내용, name: text, widget: text }]

      - label: 특강 연사·연구원
        name: people
        file: {{ R }}src/_data/people.yml
        fields:
          - label: 특강 연사
            name: speakers
            widget: object
            fields:
              - { label: 제목, name: title, widget: string }
              - { label: 영문 제목, name: title_en, widget: string }
              - { label: 문구, name: text, widget: text }
              - { label: 인원, name: count, widget: number }
              - { label: 명단 공개 전 문구, name: pending_text, widget: text }
              - label: 명단(가나다순 자동 정렬)
                name: list
                widget: list
                required: false
                summary: "{{ '{{name}} · {{affiliation}}' }}"
                fields:
                  - { label: 이름, name: name, widget: string }
                  - { label: 본직(예 ○○대학교 교수), name: affiliation, widget: string }
                  - { label: 전문 분야(2~3개), name: fields, widget: list, required: false }
              - { label: 관리 메모, name: memo, widget: text, required: false }
          - label: 연구원
            name: researchers
            widget: object
            fields:
              - { label: 제목, name: title, widget: string }
              - { label: 영문 제목, name: title_en, widget: string }
              - { label: 문구, name: text, widget: text }
              - label: 명단
                name: list
                widget: list
                fields: [{ label: 이름, name: name, widget: string }, { label: 담당 업무, name: role, widget: string }]
              - { label: 관리 메모, name: memo, widget: text, required: false }
